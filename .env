# NBA PREDICTIVE TERMINAL - CONFIGURATION

# --- API KEYS ---
# The Odds API (Required for live market data)
THE_ODDS_API_KEY=your_odds_api_key_here

# RapidAPI Key (Optional: for additional stats providers)
RAPIDAPI_KEY=your_rapidapi_key_here

# OpenAI API Key (Required for AI Narrative Insights 🤖)
OPENAI_API_KEY=your_openai_api_key_here

# --- PREDICTION SETTINGS ---
# Default Bankroll (CAD)
DEFAULT_BANKROLL=1000.0
# Kelly Criterion Fraction (e.g., 0.25 for quarter Kelly)
KELLY_FRACTION=0.25

# --- LOGGING ---
LOG_LEVEL=INFO
# Path to cache directory
CACHE_DIR=.tmp/cache
